# Copy to .env.local for local dev (and pass as Fly build args at deploy time).
# Both values are safe to expose in the browser: data access is controlled by
# Row Level Security and the get_shared_list() RPC in the database, not by
# keeping these secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Amazon Associates Store ID. When set, every "Buy on Amazon"
# link carries it as the tag= parameter; when empty, the links still
# work, just without affiliate attribution.
VITE_AMAZON_TAG=
